  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and credentials"
    },
    "/sppg_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/SppgProfile" },
      "description": "SPPG unit identity configuration"
    },
    "/beneficiary_groups/{groupId}": {
      "schema": { "$ref": "#/entities/BeneficiaryGroup" },
      "description": "Institutions and beneficiary groups"
    },
    "/beneficiaries/{beneficiaryId}": {
      "schema": { "$ref": "#/entities/Beneficiary" },
      "description": "Beneficiary counts and portion targets"
    },
    "/food_ingredients/{ingredientId}": {
      "schema": { "$ref": "#/entities/FoodIngredient" },
      "description": "Master food ingredients and stock"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Suppliers and vendors"
    },
    "/menus/{menuId}": {
      "schema": { "$ref": "#/entities/MenuPlan" },
      "description": "Menu planning, nutritional calculations, and food costs"
    },
    "/rabs/{rabId}": {
      "schema": { "$ref": "#/entities/Rab" },
      "description": "Rencana Anggaran Belanja (RAB) SPPG"
    },
    "/purchase_orders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Purchase orders generated from RAB"
    },
    "/receiving_checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/ReceivingChecklist" },
      "description": "Receiving inspections for incoming PO goods"
    },
    "/inventory_transactions/{txId}": {
      "schema": { "$ref": "#/entities/InventoryTransaction" },
      "description": "Stock in, stock out, and mutation logs"
    },
    "/division_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DivisionTask" },
      "description": "Operational division tasks (Persiapan, Pengolahan, Pemorsian, etc.)"
    },
    "/distribution_records/{distId}": {
      "schema": { "$ref": "#/entities/DistributionRecord" },
      "description": "Beneficiary delivery and vehicle dispatch logs"
    },
    "/cash_transactions/{cashId}": {
      "schema": { "$ref": "#/entities/CashTransaction" },
      "description": "General cash book and payment records"
    },
    "/organoleptic_records/{orgId}": {
      "schema": { "$ref": "#/entities/OrganolepticRecord" },
      "description": "Organoleptic sensory test logs (PIC and PLOG)"
    },
    "/letters/{letterId}": {
      "schema": { "$ref": "#/entities/LetterRecord" },
      "description": "Official letters, BAST, and assignment letters"
    },
    "/volunteer_attendance/{attId}": {
      "schema": { "$ref": "#/entities/VolunteerAttendance" },
      "description": "Volunteer attendance and substitute records"
    },
    "/institution_incentives/{incId}": {
      "schema": { "$ref": "#/entities/InstitutionIncentive" },
      "description": "Institution incentives"
    },
    "/food_waste/{wasteId}": {
      "schema": { "$ref": "#/entities/FoodWasteRecord" },
      "description": "Food waste percentage calculation and logging"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trails and action logging"
    }
  }
}
